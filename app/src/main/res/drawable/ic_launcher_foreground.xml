    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,26h9v9h-9z M38,26h9v9h-9z M50,26h9v9h-9z M62,26h9v9h-9z M74,26h9v9h-9z M26,38h9v9h-9z M38,38h9v9h-9z M50,38h9v9h-9z M62,38h9v9h-9z M74,38h9v9h-9z M26,50h9v9h-9z M38,50h9v9h-9z" />

