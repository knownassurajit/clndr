    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lived cells (filled) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,30h8v8h-8z M40,30h8v8h-8z M50,30h8v8h-8z M60,30h8v8h-8z M70,30h8v8h-8z M30,40h8v8h-8z M40,40h8v8h-8z M50,40h8v8h-8z M60,40h8v8h-8z M70,40h8v8h-8z M30,50h8v8h-8z M40,50h8v8h-8z" />

    <!-- Unspent cells (outlined) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M50.75,50.75h6.5v6.5h-6.5z M60.75,50.75h6.5v6.5h-6.5z M70.75,50.75h6.5v6.5h-6.5z M30.75,60.75h6.5v6.5h-6.5z M40.75,60.75h6.5v6.5h-6.5z M50.75,60.75h6.5v6.5h-6.5z M60.75,60.75h6.5v6.5h-6.5z M70.75,60.75h6.5v6.5h-6.5z M30.75,70.75h6.5v6.5h-6.5z M40.75,70.75h6.5v6.5h-6.5z M50.75,70.75h6.5v6.5h-6.5z M60.75,70.75h6.5v6.5h-6.5z M70.75,70.75h6.5v6.5h-6.5z" />
