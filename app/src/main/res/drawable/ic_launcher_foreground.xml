<!--
  clndr mark: a life as a 3x3 of cells. Filled = lived; rings = unspent.
  Circles (not squares) so circle / squircle / teardrop masks never clip a corner.
  Cluster is ~39dp, well inside the 72dp safe zone of the 108dp adaptive canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lived: top row + first two of the middle row. Centers 40 / 54 / 68, r=5.5. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34.5,40a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0M48.5,40a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0M62.5,40a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0M34.5,54a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0M48.5,54a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0" />

    <!-- Unspent rings share the same outer radius (stroke 2.5 on r=4.25). -->
    <path
        android:fillColor="#00000000"
        android:pathData="M68,54m-4.25,0a4.25,4.25 0 1,1 8.5,0a4.25,4.25 0 1,1 -8.5,0M40,68m-4.25,0a4.25,4.25 0 1,1 8.5,0a4.25,4.25 0 1,1 -8.5,0M54,68m-4.25,0a4.25,4.25 0 1,1 8.5,0a4.25,4.25 0 1,1 -8.5,0M68,68m-4.25,0a4.25,4.25 0 1,1 8.5,0a4.25,4.25 0 1,1 -8.5,0"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF" />
</vector>
